---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Pagina non trovata - Villa Paris" description="La pagina che cerchi non esiste o è stata spostata." locale="it" noindex={true}>
  <section class="section-padding bg-dotted min-h-screen flex items-center pt-32">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <div class="text-8xl font-display text-accent/30 mb-6">404</div>
        <h1 class="font-display text-3xl md:text-4xl font-light tracking-wide mb-4">Pagina non trovata</h1>
        <p class="text-muted-foreground font-body text-lg mb-10 leading-relaxed">
          La pagina che stai cercando non esiste o è stata spostata.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/" class="btn-primary">Torna alla Home</a>
          <a href="/contatti" class="btn-elegant">Contattaci</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
